# Copy to .env.local and fill in your own Vapi PUBLIC key and assistant ID.
# Keep real values in local/Vercel environment settings, not in this file.
# A public browser key is not a private API key; restrict its allowed origins
# and assistants in Vapi before sharing a live demo.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Set to the actual Vercel production URL after deployment.
APP_BASE_URL=http://localhost:3000
